# Database URL for Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/promptrouter?schema=public"
# Optional CA file for managed Postgres TLS (preferred over DB_SSL_INSECURE)
# DATABASE_CA_CERT="/path/to/ca.pem"
# Only when the host requires TLS without a CA you can mount:
# DB_SSL_INSECURE=1

# Authentication (required, ≥16 characters)
JWT_SECRET="your-super-secret-jwt-key"

# Comma-separated dashboard origins for credentialed CORS (required in production)
FRONTEND_ORIGIN="http://localhost:3001"

# Set to "none" only for cross-site cookies (Vercel ↔ Render). Implies Secure cookies.
# COOKIE_SAME_SITE=none

# Shared secret: primary-backend playground proxy → api-backend
INTERNAL_SERVICE_SECRET="change-me-internal-service-secret"

# primary-backend → api-backend base URL
ROUTER_API_URL="http://localhost:4000"

# Frontend build-time URLs (baked into the SPA)
API_URL="http://localhost:3000"

# LLM Provider API Keys
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="AIza..."
ANTHROPIC_API_KEY="sk-ant-..."

# Seed / payments safety
# ALLOW_DB_SEED=true
# PAYMENTS_TEST_MODE=true

# Environment
NODE_ENV="development"
